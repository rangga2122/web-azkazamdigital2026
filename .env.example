# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AzkazamDigital

# Upload Configuration
UPLOAD_MAX_SIZE_MB=5

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=AzkazamDigital
SMTP_FROM_EMAIL=halo@your-domain.com

# WhatsApp Automation
# Recommended for Coolify production: cron
# Options: cron | loop | hybrid
WHATSAPP_AUTOMATION_MODE=cron
WHATSAPP_AUTOMATION_CRON_SECRET=change-this-secret

# AI Article Automation
NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_ARTICLE_MODEL=openai/gpt-oss-120b
ARTICLE_AUTOMATION_CRON_SECRET=change-this-secret-too
